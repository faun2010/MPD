#!/bin/sh
# One-shot MPD player: auto-detect a USB DAC (fall back to onboard audio),
# write mpd.conf into the given music directory, and run mpd in the
# foreground (no daemon/service, no database left behind elsewhere).
#
# Usage:
#   ./play.sh <music_dir> [-d|--device hw:CARD,DEV] [-p|--port PORT] [-n|--dry-run]
#
# Examples:
#   ./play.sh /media/panzm/notm/todo
#   ./play.sh ~/Music -d hw:0,0          # force onboard audio
#   ./play.sh ~/Music -n                 # just print the config, don't run

set -eu

usage() {
    echo "Usage: $0 <music_dir> [-d hw:CARD,DEV] [-p PORT] [-n]" >&2
    exit 1
}

music_dir=""
device_override=""
port="6600"
dry_run="no"

while [ $# -gt 0 ]; do
    case "$1" in
        -d|--device) device_override="$2"; shift 2 ;;
        -p|--port) port="$2"; shift 2 ;;
        -n|--dry-run) dry_run="yes"; shift ;;
        -h|--help) usage ;;
        -*) echo "Unknown option: $1" >&2; usage ;;
        *)
            if [ -z "$music_dir" ]; then music_dir="$1"; else usage; fi
            shift
            ;;
    esac
done

[ -n "$music_dir" ] || usage

music_dir=$(cd "$music_dir" 2>/dev/null && pwd -P) || {
    echo "Music directory does not exist: $music_dir" >&2
    exit 1
}

command -v mpd >/dev/null 2>&1 || {
    echo "mpd not found on PATH" >&2
    exit 1
}

# --- Detect audio device -----------------------------------------------
# Prefer the lowest-numbered USB sound card (external DAC); fall back to
# the lowest-numbered card overall (onboard audio) if no USB card exists.
detect_device() {
    usb_card=""
    fallback_card=""
    usb_name=""
    fallback_name=""

    [ -r /proc/asound/cards ] || return 1

    while read -r line; do
        case "$line" in
            [0-9]*\ \[*)
                num=$(echo "$line" | sed -n 's/^\([0-9]*\) .*/\1/p')
                rest=$(echo "$line" | sed -n 's/^[0-9]* \[[^]]*\]: *//p')
                name=$(echo "$rest" | sed 's/.* - //')
                sys_path=$(readlink -f "/sys/class/sound/card$num" 2>/dev/null || true)
                if [ -z "$fallback_card" ]; then
                    fallback_card="$num"
                    fallback_name="$name"
                fi
                case "$sys_path" in
                    */usb*/*|*/usb[0-9]*)
                        if [ -z "$usb_card" ]; then
                            usb_card="$num"
                            usb_name="$name"
                        fi
                        ;;
                esac
                ;;
        esac
    done < /proc/asound/cards

    if [ -n "$usb_card" ]; then
        card="$usb_card"; card_name="$usb_name"; kind="USB DAC"
    elif [ -n "$fallback_card" ]; then
        card="$fallback_card"; card_name="$fallback_name"; kind="onboard fallback"
    else
        return 1
    fi

    pcm=$(ls "/proc/asound/card$card" 2>/dev/null | sed -n 's/^pcm\([0-9]*\)p$/\1/p' | head -n1)
    pcm="${pcm:-0}"

    echo "hw:$card,$pcm|$card_name|$kind"
}

if [ -n "$device_override" ]; then
    audio_device="$device_override"
    audio_name="$device_override"
    audio_kind="manual override"
else
    detected=$(detect_device) || {
        echo "No sound card found (checked /proc/asound/cards)" >&2
        exit 1
    }
    audio_device=$(echo "$detected" | cut -d'|' -f1)
    audio_name=$(echo "$detected" | cut -d'|' -f2)
    audio_kind=$(echo "$detected" | cut -d'|' -f3)
fi

echo "Audio output: $audio_device  ($audio_name, $audio_kind)" >&2

# --- Write mpd.conf next to the music, runtime state in .mpd/ ----------
runtime_dir="$music_dir/.mpd"
mkdir -p "$runtime_dir/playlists"
conf="$music_dir/mpd.conf"

cat > "$conf" <<EOF
# Auto-generated by play.sh — safe to regenerate, do not hand-edit.
# Music: $music_dir
# Audio: $audio_device ($audio_name, $audio_kind)

music_directory	"$music_dir"
playlist_directory	"$runtime_dir/playlists"
db_file			"$runtime_dir/db"
log_file		"$runtime_dir/mpd.log"
state_file		"$runtime_dir/state"
sticker_file		"$runtime_dir/sticker.sql"

bind_to_address		"127.0.0.1"
port			"$port"
log_level		"notice"

auto_update		"yes"
follow_outside_symlinks	"yes"
follow_inside_symlinks		"yes"
filesystem_charset	"UTF-8"

decoder {
	plugin			"sacdiso"
	playable_area		"stereo"
	use_stdio		"yes"
}
decoder {
	plugin			"dsdiff"
	playable_area		"stereo"
	use_stdio		"yes"
}

audio_output {
	type			"alsa"
	name			"$audio_name"
	device			"$audio_device"
	auto_resample		"no"
	auto_channels		"no"
	auto_format		"no"
	mixer_type		"software"
	dop			"no"
}
EOF

echo "Config written: $conf" >&2

if [ "$dry_run" = "yes" ]; then
    cat "$conf"
    exit 0
fi

echo "Starting mpd on 127.0.0.1:$port ..." >&2
exec mpd --no-daemon --stderr "$conf"
